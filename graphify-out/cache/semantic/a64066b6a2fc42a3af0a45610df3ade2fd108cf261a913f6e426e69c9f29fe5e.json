{"nodes": [{"id": "spec_017_doc", "label": "Spec 017 \u00ab Reprise \u2014 Voir \u00bb", "file_type": "document", "source_file": "specs/017-reprise-voir/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "spec_017_d18", "label": "D18 Carte de structure : n\u0153uds selon leur contenu", "file_type": "rationale", "source_file": "specs/017-reprise-voir/spec.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "L'aspect d'un \u00e9l\u00e9ment dit ce qu'il contient r\u00e9ellement, calcul\u00e9 par l'app (jamais par Claude) : page + badge Doc, \u00e9diteur + badge Code (config compt\u00e9e comme code), fichiers sensibles jamais compt\u00e9s ; n\u0153ud 304 \u00d7 144 px."}, {"id": "spec_017_d19", "label": "D19 Carte de structure : \u00e9tat visuel du statut", "file_type": "rationale", "source_file": "specs/017-reprise-voir/spec.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Statut lisible d'un coup d'\u0153il, jamais par la couleur seule : pastille + ic\u00f4ne + libell\u00e9, bande de 4 px, contour pointill\u00e9 rouge si bloqu\u00e9e."}, {"id": "spec_017_d20", "label": "D20 Carte de structure : vue \u00ab Architecture \u00bb", "file_type": "rationale", "source_file": "specs/017-reprise-voir/spec.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bascule Progression | Architecture ; bandes par couche de l'ext\u00e9rieur vers le c\u0153ur ; Claude d\u00e9cide \u00e0 la cartographie, l'app d\u00e9duit (\u00ab d\u00e9duite \u00bb), la correction de mentalyas prime et s'annule."}, {"id": "spec_017_d21", "label": "D21 Carte de structure : avancement vivant", "file_type": "rationale", "source_file": "specs/017-reprise-voir/spec.md", "source_location": "L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claude tient l'\u00e9l\u00e9ment de sa conversation \u00e0 jour (statut, %, reste \u00e0 faire) \u00e0 chaque \u00e9tape ; \u00e9criture \u00ab par Claude \u00bb, annulable ; avancement mixte parent/feuille."}, {"id": "spec_017_fr_039", "label": "FR-039 Aspect doc / code calcul\u00e9 par l'app", "file_type": "document", "source_file": "specs/017-reprise-voir/spec.md", "source_location": "L343", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "spec_017_fr_040", "label": "FR-040 Pastille, bande et contour de statut", "file_type": "document", "source_file": "specs/017-reprise-voir/spec.md", "source_location": "L344", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "spec_017_fr_041", "label": "FR-041 Vue Architecture, puce de couche, violations", "file_type": "document", "source_file": "specs/017-reprise-voir/spec.md", "source_location": "L345", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "spec_017_fr_042", "label": "FR-042 Claude met \u00e0 jour statut/avancement ; barre d'avancement", "file_type": "document", "source_file": "specs/017-reprise-voir/spec.md", "source_location": "L346", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "spec_017_architecture_catalog", "label": "Catalogue d'architectures (Clean, hexagonale, MVVM, MVC, en couches)", "file_type": "rationale", "source_file": "specs/017-reprise-voir/spec.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chaque architecture reconnue fixe la profondeur de ses couches (1 ext\u00e9rieur \u2192 3 c\u0153ur) ; \u00ab aucune \u00bb : pas de vue Architecture."}, {"id": "spec_017_dependency_rule", "label": "R\u00e8gle de d\u00e9pendance unique (violation profonde \u2192 moins profonde)", "file_type": "rationale", "source_file": "specs/017-reprise-voir/spec.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un lien d'une couche plus profonde vers une moins profonde est une violation, trac\u00e9e en rouge avec son nombre d'appels."}, {"id": "spec_017_element_avancer", "label": "Outil MCP `element_avancer`", "file_type": "rationale", "source_file": "specs/017-reprise-voir/spec.md", "source_location": "L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outil l\u00e9ger d\u00e9di\u00e9 : statut, avancement 0\u2013100 %, reste \u00e0 faire ; livr\u00e9e \u21d2 100 %, sans recartographier."}, {"id": "spec_017_avancement_mixte", "label": "Avancement mixte (moyenne des sous-\u00e9l\u00e9ments / % d\u00e9clar\u00e9)", "file_type": "rationale", "source_file": "specs/017-reprise-voir/spec.md", "source_location": "L34", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "spec_017_structure_dessiner", "label": "Outil MCP `structure_dessiner` (champs architecture, couche)", "file_type": "document", "source_file": "specs/017-reprise-voir/spec.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "spec_017_doc", "target": "spec_017_d18", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/017-reprise-voir/spec.md", "source_location": "L31", "weight": 1.0}, {"source": "spec_017_doc", "target": "spec_017_d19", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/017-reprise-voir/spec.md", "source_location": "L32", "weight": 1.0}, {"source": "spec_017_doc", "target": "spec_017_d20", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/017-reprise-voir/spec.md", "source_location": "L33", "weight": 1.0}, {"source": "spec_017_doc", "target": "spec_017_d21",