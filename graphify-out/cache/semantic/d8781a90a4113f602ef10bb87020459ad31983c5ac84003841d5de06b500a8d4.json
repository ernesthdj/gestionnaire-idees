{"nodes": [{"id": "journal_regles_apprises", "label": "R\u00e8gles apprises (table du JOURNAL)", "file_type": "document", "source_file": "docs/JOURNAL.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "journal_spec004_lot1_toolmenu", "label": "Spec 004 lot 1 : bo\u00eete \u00e0 outils au clic droit, notes sur la carte (T001\u2013T007)", "file_type": "document", "source_file": "docs/JOURNAL.md", "source_location": "L346", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Notes et widgets r\u00e9utilisent canvas_blocks (colonne kind) ; bornes de taille v\u00e9rifi\u00e9es par le main ; suppression douce annulable."}, {"id": "journal_spec004_widget_claude", "label": "Spec 004 lots 2-3 : widget isol\u00e9 g\u00e9n\u00e9r\u00e9 par Claude (T008\u2013T018)", "file_type": "document", "source_file": "docs/JOURNAL.md", "source_location": "L351", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Isolement en couches ind\u00e9pendantes du mod\u00e8le ; transpilation stripTypeScriptTypes en mode transform ; code courant envoy\u00e9 en verbatim, seule la demande est anonymis\u00e9e."}, {"id": "journal_constitution_1_2_0", "label": "Constitution 1.2.0 (exception widget au principe III)", "file_type": "rationale", "source_file": "docs/JOURNAL.md", "source_location": "L347", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "journal_idee_de_depart_hexagone", "label": "Id\u00e9e de d\u00e9part : hexagone, fiche, r\u00e9sum\u00e9 local, verrouillage r\u00e9serv\u00e9 (T070)", "file_type": "document", "source_file": "docs/JOURNAL.md", "source_location": "L362", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seule l'id\u00e9e de d\u00e9part porte l'identit\u00e9 d'un brainstorming ; r\u00e9sum\u00e9 local via t\u00e2che resumer, sans cr\u00e9dit Claude."}, {"