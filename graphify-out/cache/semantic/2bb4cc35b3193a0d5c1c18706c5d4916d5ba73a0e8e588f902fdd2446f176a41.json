{"nodes": [{"id": "journal_doc", "label": "JOURNAL du projet (07/10 apr\u00e8s 16h)", "file_type": "document", "source_file": "docs/JOURNAL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "journal_spec019_us1_sonde", "label": "FEAT spec 019 US1 : sonde sans contenu de l'Analyste interne", "file_type": "rationale", "source_file": "docs/JOURNAL.md", "source_location": "L793", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Une donn\u00e9e \u00ab sans contenu \u00bb se prouve par un test qui cherche les vrais textes du profil d\u00e9mo dans tout ce qui est stock\u00e9, pas par la relecture du sch\u00e9ma."}, {"id": "journal_fix_analyste_settings_loading", "label": "FIX R\u00e9glages \u203a Analyste chargeait sans fin (z.undefined)", "file_type": "rationale", "source_file": "docs/JOURNAL.md", "source_location": "L799", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tester un canal IPC avec la charge utile exacte qu'envoie l'interface ; toute vue qui attend une requ\u00eate doit avoir un \u00e9tat d'erreur."}, {"id": "journal_spec017_d18_nodes_content", "label": "FEAT spec 017 D18 : n\u0153uds selon leur contenu (doc / code)", "file_type": "rationale", "source_file": "docs/JOURNAL.md", "source_location": "L806", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pas de nombre de fichiers sur le n\u0153ud : deux comptes diff\u00e9rents recr\u00e9eraient la confusion \u00ab 3 fichiers / 37 \u00bb corrig\u00e9e en D17."}, {"id": "journal_spec017_d19_status_visual", "label": "FEAT spec 017 D18 lisibilit\u00e9 + D19 \u00e9tat visuel du statut", "file_type": "rationale", "source_file": "docs/JOURNAL.md", "source_location": "L811", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sur un n\u0153ud de taille fixe, chaque zone a une hauteur r\u00e9serv\u00e9e et rien ne passe \u00e0 la ligne sans limite ; texte complet au survol."}, {"id": "journal_spec017_d20_architecture_view", "label": "FEAT spec 017 D20 : vue \u00ab Architecture \u00bb de la carte de structure", "file_type": "rationale", "source_file": "docs/JOURNAL.md", "source_location": "L819", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deux lectures d'une m\u00eame carte = deux dispositions pures c\u00f4te \u00e0 c\u00f4te, choisies \u00e0 l'affichage ; ne jamais faire porter deux sens aux m\u00eames positions. Nouveau type de lot d'Historique `structure` pour rendre les corrections annulables."}, {"id": "journal_fix_cartographie_consigne", "label": "FIX D20 : consigne de cartographie (couche = attribut) et position de la barre", "file_type": "rationale", "source_file": "docs/JOURNAL.md", "source_location": "L825", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Une consigne \u00e0 l'IA qui ajoute une notion doit dire ce qu'elle ne change pas ; sinon l'IA r\u00e9organise autour de la nouvelle notion."}, {"id": "journal_fix_structure_dessiner_vs_dessiner", "label": "FIX D20 : Claude cartographiait avec `dessiner` au lieu de `structure_dessiner`", "file_type": "rationale", "source_file": "docs/JOURNAL.md", "source_location": "L829", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quand deux consignes de l'IA se recoupent, la plus pr\u00e9cise doit nommer l'outil \u00e0 utiliser ET celui \u00e0 ne pas utiliser."}, {"id": "journal_spec017_d21_avancement", "label": "FEAT spec 017 D21 : avancement vivant des \u00e9l\u00e9ments de carte", "file_type": "rationale", "source_file": "docs/JOURNAL.md", "source_location": "L833", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Une donn\u00e9e que l'IA doit tenir \u00e0 jour a besoin de son propre outil l\u00e9ger et d'une consigne au bon endroit ; redessiner toute la carte pour un statut n'arrive jamais."}, {"id": "journal_session_end_2149", "label": "SESSION End 07/10 21:49 (T079 encore \u00e0 faire)", "file_type": "document", "source_file": "docs/JOURNAL.md", "source_location": "L838", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "journal_doc", "target": "journal_spec019_us1_sonde", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/JOURNAL.md", "source_location": "L793", "weight": 1.0}, {"source": "journal_doc", "target": "journal_spec017_d18_nodes_content", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/JOURNAL.md", "source_location": "L806", "weight": 1.0}, {"source": "journal_doc", "target": "journal_spec017_d20_architecture_view", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/JOURNAL.md", "source_location": "L819", "weight": 1.0}, {"source": "journal_doc", "target": "journal_spec017_d21_avancement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/JOURNAL.md", "source_location": "L833", "weight": 1.0}, {"source": "journal_doc", "target": "journal_session_end_2149", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/JOURNAL.md", "source_location": "L838", "weight": 1.0}, {"source": "journal_spec019_us1_sonde", "target": "tasks_019_us1_sonde", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/JOURNAL.md", "source_location": "L793", "weight": 1.0}, {"source": "journal_spec019_us1_sonde", "target": "tasks_019_migration_0030", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/JOURNAL.md", "source_location": "L794", "weight": 1.0}, {"source": "journal_spec019_us1_sonde", "target": "tasks_019_sc0