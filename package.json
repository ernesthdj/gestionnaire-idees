{
  "name": "gestionnaire-idees",
  "version": "0.1.0",
  "private": true,
  "description": "Agenda organique : capture rapide d'idées, structuration par IA hybride, organigramme et rappels.",
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "bench:local": "tsx scripts/bench-local-model.ts",
    "seed:demo": "electron-vite dev -- --demo",
    "seed:demo:reset": "electron-vite dev -- --demo --reset"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@tanstack/react-query": "5.104.0",
    "@xyflow/react": "12.12.0",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@13.0.3",
    "d3-force": "3.0.0",
    "drizzle-orm": "0.45.3",
    "highlight.js": "11.12.0",
    "motion": "13.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/d3-force": "3.0.10",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.13.0",
    "drizzle-kit": "0.31.11",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  }
}
