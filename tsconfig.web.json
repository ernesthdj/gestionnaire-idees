{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [],
    "outDir": "out/.tsc/web"
  },
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/env.d.ts",
    "src/preload/*.d.ts",
    "src/shared/**/*",
    "tests/unit/renderer/**/*",
    "tests/unit/ui/**/*",
    "tests/fixtures/ui/**/*",
    "tests/support/axe.ts",
    "tests/support/renderer-setup.ts"
  ]
}
