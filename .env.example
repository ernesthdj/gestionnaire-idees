# Exemple FICTIF — copier en .env (jamais commité). Aucune valeur réelle ici.
#
# La clé API Claude n'est PAS lue depuis .env : elle se saisit dans l'app (Réglages › IA)
# et est chiffrée par Windows (safeStorage / DPAPI).

# Identifiant de l'application Microsoft Entra (client public, comptes personnels) — MVP-2 / F6
MSAL_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Adresse du service Ollama local (doit rester en 127.0.0.1)
OLLAMA_URL=http://127.0.0.1:11434
