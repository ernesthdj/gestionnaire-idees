{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "out/.tsc/node"
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*",
    "src/mcp-relay/**/*",
    "src/analysis-worker/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "tests/unit/renderer/**/*",
    "tests/unit/ui/**/*",
    "tests/fixtures/ui/**/*",
    "tests/fixtures/reprise/**/*",
    "tests/support/axe.ts",
    "tests/support/renderer-setup.ts"
  ]
}
